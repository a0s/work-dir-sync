#!/bin/bash
#
# work-dir-sync configuration — copy to config.sh and fill in.
#
#   cp config.sh.example config.sh && chmod 600 config.sh
#
# config.sh holds credentials and is NOT committed (see .gitignore).
# The running daemon watches this file: saving it re-execs the daemon, so new
# storages and pairs are picked up automatically (syntax is checked first).
#
# Only the two blocks below are required. Every other knob has a default in
# sync.sh and only needs to be set here to override it — see the "Defaults"
# section at the top of sync.sh for the full list.

# Remote backends: storage <name> type=<backend> <key>=<value> ...
# Keys are exactly the rclone config keys, see https://rclone.org/s3/,
# https://rclone.org/sftp/ etc. Any backend rclone supports works here.
define_storages() {

  # Cloudflare R2
  storage r2-cloudflare \
    type=s3 \
    provider=Cloudflare \
    region=auto \
    endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com \
    access_key_id=<ACCESS_KEY_ID> \
    secret_access_key=<SECRET_ACCESS_KEY> \
    no_check_bucket=true

  # Your own server over SSH. rclone speaks SFTP itself — no sshfs, no macFUSE,
  # nothing to mount; the server only needs a working sshd.
  #
  # Already described in ~/.ssh/config? Point rclone at the system ssh and the
  # whole entry applies (HostName, User, IdentityFile, ProxyJump, …). With ssh=
  # set rclone ignores its own host/user/port/key_file keys:
  # storage my-server type=sftp ssh="ssh my-server"
  #
  # Otherwise spell the connection out:
  # storage my-server \
  #   type=sftp \
  #   host=example.com \
  #   user=bob \
  #   port=22 \
  #   key_file=$HOME/.ssh/id_ed25519 \
  #   known_hosts_file=$HOME/.ssh/known_hosts \
  #   shell_type=unix \
  #   md5sum_command=md5sum \
  #   sha1sum_command=sha1sum
  #
  # The key must be usable without typing anything: the daemon runs under
  # launchd and has no terminal to ask on. Either use a passphrase-less key, or
  # add key_file_pass=<passphrase> (rclone stores it scrambled in rclone.conf).
  # Password login instead of a key: pass=<password>, same caveat.
  # known_hosts_file is what makes rclone verify the host key at all — without
  # it any server answering on that address is accepted.
  # shell_type/md5sum_command/sha1sum_command are optional: they only spare
  # rclone the probing it otherwise does on every connection.

  # storage b2-backup type=b2 account=... key=...
}

# Pairs to keep in sync: "<storage>:<path>|<local folder>"
# For object storage the remote path is "<bucket>[/subfolder]", for SSH servers
# it is a path on the server — absolute ("srv:/srv/sync") or relative to the
# login home ("srv:sync"). The local folder is created automatically.
SYNC_PAIRS=(
  "r2-cloudflare:my-bucket|$HOME/my-folder"
  # "r2-cloudflare:another-bucket/some_folder|$HOME/another-folder"
  # "my-server:/srv/work-dir-sync/notes|$HOME/notes"
)

# Optional overrides, defaults shown:
# POLL_INTERVAL=60           # remote polling interval, seconds
# PROPAGATE_EMPTY_SIDE=0     # 1 = a wiped side really wipes the other one
# MAX_DELETE_PERCENT=50      # mass-deletion guard
# EXTRA_RCLONE_FLAGS=""      # e.g. "--bwlimit 10M"
# SFTP_TRANSFERS=4           # parallelism for SSH pairs; one connection each,
# SFTP_CHECKERS=4            # and sshd hands out ten by default (MaxSessions)
# SFTP_COMPARE="size,modtime,checksum"
#                            # SSH pairs compare by content: the server hashes
#                            # the file itself, so two machines cannot drift
#                            # apart unnoticed. With ssh= set ControlMaster in
#                            # ~/.ssh/config, or every hash opens a connection.

# --- optional: push notifications over MQTT ---------------------------------
# Without this the daemon polls the change marker every POLL_INTERVAL seconds.
# With it the other machine is notified instantly and the marker is only read
# every PUSH_FALLBACK_POLL seconds as a fallback.
# Needs mosquitto (brew install mosquitto). Works with any MQTT broker;
# HiveMQ Cloud Serverless has a permanently free tier.
# PUSH_MQTT_HOST="xxxxxxxx.s1.eu.hivemq.cloud"
# PUSH_MQTT_PORT=8883
# PUSH_MQTT_USER="..."
# PUSH_MQTT_PASS="..."
# PUSH_MQTT_TOPIC_PREFIX="work-dir-sync"   # topic per pair: <prefix>/<bucket>
# PUSH_FALLBACK_POLL=1800
